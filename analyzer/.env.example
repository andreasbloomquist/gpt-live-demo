# -----------------------------------------------------------------------------
# Call Analyzer. Copy to `.env` in this directory (never commit it).
# All values below are PLACEHOLDERS.
# -----------------------------------------------------------------------------

# --- HTTP API ---
# Shared bearer token: the agent (POST /v1/calls) and the frontend's server routes (reads) send it.
# Required; at least 16 characters. Generate one with: openssl rand -hex 32
CALL_ANALYZER_TOKEN=change-me-shared-secret
ANALYZER_HOST=127.0.0.1
ANALYZER_PORT=8080
# ANALYZER_MAX_BODY_BYTES=2097152
# Serve /docs, /redoc and /openapi.json (unauthenticated). Keep off when deployed.
# ANALYZER_ENABLE_DOCS=false

# --- Storage ---
ANALYZER_DB_PATH=./data/calls.db

# --- Judge provider ---
# auto      -> openai if an API key is set, else heuristic
# openai    -> LLM-as-judge via any OpenAI-compatible Chat Completions endpoint
# heuristic -> deterministic, offline keyword + metrics scoring (no key needed)
ANALYZER_PROVIDER=auto
# Falls back to OPENAI_API_KEY when unset.
# ANALYZER_API_KEY=sk-your-api-key
ANALYZER_MODEL=gpt-5.4-mini
# Leave empty for api.openai.com. Examples:
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq:   https://api.groq.com/openai/v1
#   Ollama: http://localhost:11434/v1   (ANALYZER_API_KEY=ollama)
ANALYZER_BASE_URL=
# Sent as `reasoning_effort` (none|minimal|low|medium|high). Leave EMPTY for non-reasoning models
# and for servers that reject the parameter.
ANALYZER_REASONING_EFFORT=low
# Output-cap parameter name: max_completion_tokens (OpenAI) or max_tokens (some compatible servers).
# ANALYZER_MAX_TOKENS_PARAM=max_completion_tokens
# ANALYZER_MAX_OUTPUT_TOKENS=8000
# ANALYZER_TIMEOUT_S=60
# ANALYZER_SDK_RETRIES=2
# ANALYZER_MAX_PROMPT_CHARS=60000

# --- Background worker ---
# ANALYZER_CONCURRENCY=2
# ANALYZER_MAX_ATTEMPTS=3
# ANALYZER_RETRY_BASE_S=30
# ANALYZER_JOB_TIMEOUT_S=300
# ANALYZER_POLL_INTERVAL_S=2

LOG_LEVEL=INFO
