# All of these are read server-side only and never sent to the browser.

# LiveKit project credentials (https://cloud.livekit.io -> Settings -> Keys).
# Used by app/api/token/route.ts to mint per-call access tokens.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# The agent worker registers as `gpt-live-agent` by default (explicit dispatch), so the token
# must request it by name. Keep this in sync with LIVEKIT_AGENT_NAME in the repo-root .env.
# Leave empty only if you run the worker with automatic dispatch (LIVEKIT_AGENT_NAME= empty there).
LIVEKIT_AGENT_NAME=gpt-live-agent

# Call Analyzer (../analyzer), which backs the Calls pages. Use the same token as the
# analyzer's CALL_ANALYZER_TOKEN (at least 16 characters).
CALL_ANALYZER_URL=http://localhost:8080
CALL_ANALYZER_TOKEN=change-me-shared-secret

# Optional. If set, the site asks for this passcode before starting calls or showing call
# history (see lib/passcode.ts). Leave empty for open access on localhost.
DEMO_PASSCODE=
