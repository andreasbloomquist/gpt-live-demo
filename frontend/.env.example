# LiveKit project credentials (https://cloud.livekit.io -> Settings -> Keys).
# These are read server-side only by app/api/token/route.ts and never sent to the browser.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Optional: if the agent worker registers with an explicit agent_name, set the same name here
# so the token dispatches that agent into the room. Leave empty for automatic dispatch.
LIVEKIT_AGENT_NAME=
