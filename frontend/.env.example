# LiveKit project credentials (https://cloud.livekit.io -> Settings -> Keys).
# These are read server-side only by app/api/token/route.ts and never sent to the browser.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# The agent worker registers as `gpt-live-agent` by default (explicit dispatch), so the token
# must request it by name. Keep this in sync with LIVEKIT_AGENT_NAME in the repo-root .env.
# Leave empty only if you run the worker with automatic dispatch (LIVEKIT_AGENT_NAME= empty there).
LIVEKIT_AGENT_NAME=gpt-live-agent
