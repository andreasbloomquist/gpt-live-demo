# -----------------------------------------------------------------------------
# Copy to `.env` (never commit it). All values below are PLACEHOLDERS.
# -----------------------------------------------------------------------------

# --- LiveKit (https://cloud.livekit.io -> Settings -> Keys, or self-hosted) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- OpenAI (GPT-Live voice model + backend Responses model) ---
OPENAI_API_KEY=sk-your-openai-api-key

# GPT-Live voice model + voice (aster | beacon | cinder | marin | stone | vesper)
GPT_LIVE_MODEL=gpt-live-1
GPT_LIVE_VOICE=marin
# Backend "brain" model that GPT-Live delegates reasoning + tool calls to
GPT_LIVE_BACKEND_MODEL=gpt-5.6-luna
GPT_LIVE_BACKEND_REASONING_EFFORT=low
# Optional backend tuning
# GPT_LIVE_BACKEND_VERBOSITY=low
# GPT_LIVE_BACKEND_MAX_OUTPUT_TOKENS=

# --- Agent runtime ---
# Name used for explicit dispatch (the frontend sends the same value). Set empty for automatic dispatch.
LIVEKIT_AGENT_NAME=gpt-live-agent
# Timezone used to resolve "today" / relative dates in prompts
AGENT_TIMEZONE=America/Los_Angeles

# --- Prompt composition ---
# Which agent profile in prompts/manifest.yaml to run
AGENT_PROFILE=concierge
# PROMPTS_DIR=./prompts

# --- Web search (OpenAI built-in tool, runs on the backend model) ---
WEB_SEARCH_CONTEXT_SIZE=low

# --- Restaurant availability provider ---
# mock      -> deterministic, offline fake data (default; used by evals)
# opentable -> OpenTable partner API (requires approved partner credentials)
RESTAURANT_PROVIDER=mock
OPENTABLE_API_BASE_URL=https://platform.opentable.com
OPENTABLE_CLIENT_ID=your_opentable_client_id
OPENTABLE_CLIENT_SECRET=your_opentable_client_secret
# OPENTABLE_OAUTH_URL=https://oauth.opentable.com/api/v2/oauth/token
# OPENTABLE_TIMEOUT_SECONDS=6

# --- Logging ---
LOG_LEVEL=INFO
